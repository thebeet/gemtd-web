{
  "name": "gemtd-web",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "start": "concurrently -k \"npm run server\" \"npm run dev\"",
    "build": "vue-tsc -b && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "start:prod": "tsx server/index.ts",
    "preview": "vite preview",
    "test:browser": "node --import tsx tests/browser-smoke.ts"
  },
  "dependencies": {
    "@vueuse/core": "^12.5.0",
    "three": "^0.173.0",
    "vue": "^3.5.13",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.23"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.173.0",
    "@types/ws": "^8.5.13",
    "@vue/tsconfig": "^0.7.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
