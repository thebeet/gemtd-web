{
  "name": "yjs-markdown-collab-demo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "start": "concurrently -k \"npm run server\" \"npm run dev\"",
